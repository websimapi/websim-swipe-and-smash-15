    if (!noDelay) await this.pausableTimeout(300);
    
    candiesToRemove.forEach(candy => candy.remove());
    
    await this.dropCandies(noDelay);
    await this.fillBoard(false, noDelay);
    
    await this.processMatches(false, null, noDelay);
}

